# ─── POLARIS — Local Docker Compose env ───────────────────────────────────────
# Copy this file to .env and fill in your real values.
# This file is used by docker-compose.yml only (NOT deployed to Render).

# ── ML Service ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-70b-8192

# ── Backend ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/polaris?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ── Frontend (build-arg — baked into the JS bundle) ──────────────────────────
# Point this at your backend container (inside Docker, backend is at port 5001)
VITE_API_URL=http://localhost:5001

# ── Frontend URL (used by backend for CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:80
